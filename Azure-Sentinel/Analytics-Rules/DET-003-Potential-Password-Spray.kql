// Detection ID: DET-003
// Name: Potential Password Spray
// Platform: Microsoft Sentinel
// Data source: SigninLogs
// Severity: High
// MITRE ATT&CK: T1110.003 - Password Spraying
// Purpose: Find source IPs with failed sign-ins against many accounts in a short period.
// Investigation: Check the targeted accounts, applications, source IP reputation, and
//                subsequent successful sign-ins. Correlate with identity protection alerts.
// False positives: Shared NATs, identity providers, and misconfigured applications can
//                  generate failures for many users. Tune thresholds for your environment.
// Reference: https://attack.mitre.org/techniques/T1110/003/

SigninLogs
| where TimeGenerated >= ago(15m)
| where ResultType != "0"
| where isnotempty(IPAddress)
| where isnotempty(UserPrincipalName)
| summarize
    FailedAttempts = count(),
    TargetedAccounts = dcount(UserPrincipalName),
    Accounts = make_set(UserPrincipalName, 20),
    Applications = make_set(AppDisplayName, 10)
    by IPAddress, TimeWindow = bin(TimeGenerated, 15m)
| where TargetedAccounts >= 10 and FailedAttempts >= 20
| project TimeWindow, IPAddress, FailedAttempts, TargetedAccounts, Accounts, Applications
| order by TimeWindow desc
