// Detection ID: DET-005
// Name: Entra Application or Service Principal Credential Addition
// Platform: Microsoft Sentinel
// Data source: AuditLogs
// Severity: High
// MITRE ATT&CK: T1098.001 - Additional Cloud Credentials
// Purpose: Find successful additions of credentials to Entra applications or service principals.
// Investigation: Validate the initiator, source IP, target application, change approval, and
//                subsequent sign-ins or resource access by the target service principal.
// False positives: Approved application deployments and credential rotations create legitimate
//                  events. Tune using known automation identities and change windows, not by
//                  broadly suppressing credential-addition operations.
// Limitations: Detects the named add-credential audit operations. Validate operation names in
//              your tenant and add other observed credential-addition operations as needed.
// Reference: https://attack.mitre.org/techniques/T1098/001/
// Reference: https://learn.microsoft.com/en-us/entra/identity/monitoring-health/reference-audit-activities
// Reference: https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/auditlogs

AuditLogs
| where TimeGenerated >= ago(1d)
| where OperationName in~ (
    "Add application credentials",
    "Add service principal credentials"
)
| where Result =~ "success"
| extend InitiatingUser = tostring(InitiatedBy.user.userPrincipalName)
| extend InitiatingApp = tostring(InitiatedBy.app.displayName)
| extend InitiatingActor = coalesce(InitiatingUser, InitiatingApp, Identity)
| extend InitiatingActorId = coalesce(
    tostring(InitiatedBy.user.id),
    tostring(InitiatedBy.app.servicePrincipalId)
)
| extend InitiatingIPAddress = coalesce(
    tostring(InitiatedBy.user.ipAddress),
    tostring(InitiatedBy.app.ipAddress)
)
| mv-expand TargetResource = TargetResources
| extend
    TargetResourceName = tostring(TargetResource.displayName),
    TargetResourceType = tostring(TargetResource.type),
    TargetResourceId = tostring(TargetResource.id)
| project
    TimeGenerated,
    OperationName,
    InitiatingActor,
    InitiatingActorId,
    InitiatingIPAddress,
    TargetResourceName,
    TargetResourceType,
    TargetResourceId,
    Result,
    ResultDescription,
    CorrelationId
| order by TimeGenerated desc
